# Copia este archivo a .env y completa los valores reales.

# --- Base de datos ---
DATABASE_URL=postgres://usuario:password@localhost:5432/nutriplantillas

# --- Sesión ---
# Genera uno propio, ej: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia-esto-por-un-valor-largo-y-aleatorio

# --- Servidor ---
PORT=4000
BACKEND_URL=http://localhost:4000
# Admite lista separada por comas para varios dominios de frontend (con/sin
# www, staging + producción, etc). El primero de la lista es el destino de
# las redirecciones tras el pago.
FRONTEND_URL=http://localhost:5500

# Correos que reciben rol "admin" al registrarse (separados por coma).
ADMIN_EMAILS=admin@nutriplantillas.cl

# --- Proveedor de pago (Fase 3) ---
# El backend habla con un PaymentProvider abstracto, no con un proveedor
# directo. 'manual' = proveedor simulado: NO cobra, deja el pedido en
# payment_processing y solo un admin puede confirmarlo. Es el valor por
# defecto. Otros valores registrados: 'webpay' (Transbank), 'flow' (Flow.cl).
PAYMENT_PROVIDER=manual

# --- Correo de verificación (registro estilo Flow) ---
# Sin estas variables el registro sigue funcionando: el enlace de verificación
# solo queda en el log del servidor en vez de llegar por correo real.
# Cualquier proveedor SMTP sirve (Gmail con contraseña de aplicación, Resend,
# SendGrid SMTP, etc.).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- Webpay Plus (Transbank) ---
# TODAVÍA NO CONECTADO. Estas variables existen para la Fase 4; con
# PAYMENT_PROVIDER=manual no se leen.
# Vacío = usa automáticamente las credenciales públicas de INTEGRACIÓN (sandbox)
# que trae el SDK oficial. Para cobrar de verdad, completa con las credenciales
# que Transbank te entrega al afiliar tu comercio y pon TRANSBANK_ENV=production.
TRANSBANK_COMMERCE_CODE=
TRANSBANK_API_KEY=
TRANSBANK_ENV=integration

# --- Flow (https://www.flow.cl) ---
# TODAVÍA NO CONECTADO salvo que completes esto y pongas PAYMENT_PROVIDER=flow.
# Se obtienen en tu panel de Flow (Desarrolladores → Llaves API) tras afiliar
# tu comercio. FLOW_ENV=integration usa el sandbox (flow.cl/docs, cuenta de
# prueba separada); FLOW_ENV=production cobra de verdad.
FLOW_API_KEY=
FLOW_SECRET_KEY=
FLOW_ENV=integration

# --- Reconciliación de pagos atascados ---
# Minutos de gracia antes de considerar "atascado" un pedido pending.
RECONCILE_GRACE_MINUTES=10
# true = desactiva el setInterval automático dentro del proceso web (usar
# si vas a correr `npm run reconcile` por cron del sistema operativo en su lugar).
DISABLE_INPROCESS_RECONCILER=false

# --- Fase B: seguridad de sesión ---
# NODE_ENV=production activa la cookie "secure" (solo viaja por HTTPS).
NODE_ENV=development

# 'lax' funciona si frontend y backend son subdominios del mismo dominio raíz.
# 'none' es obligatorio si terminan en dominios completamente distintos —
# y automáticamente fuerza secure:true (los navegadores exigen ambas juntas).
COOKIE_SAME_SITE=lax

# Cuánto dura una sesión (JWT + fila en `sessions` + cookie), en días.
# 3650 (~10 años) = "no caduca" en la práctica. Sigue siendo revocable con
# logout / logout-all en cualquier momento, expiración y revocación son cosas
# distintas.
SESSION_DURATION_DAYS=3650

# --- Login con Google / Apple ---
# Google: crea un OAuth Client ID (tipo "Web application") en
# https://console.cloud.google.com/apis/credentials — es gratis. Agrega el
# dominio real del frontend en "Authorized JavaScript origins".
GOOGLE_CLIENT_ID=

# Apple: "Sign in with Apple" requiere una cuenta de Apple Developer Program
# (de pago, ~99 USD/año). Se configura un "Services ID" en
# https://developer.apple.com/account/resources/identifiers — ese identificador
# (ej. com.tuempresa.web) va acá, no el App ID.
APPLE_CLIENT_ID=
